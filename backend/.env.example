# Copia este archivo a .env (cp backend/.env.example backend/.env) y pon tus valores. .env NUNCA se sube a git:
# guarda una copia de tus valores reales en un gestor de contraseñas. Detalle de cada variable: README, «Configuración».

# --- Django ---
# Genera una: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (PostGIS) y Redis ---
# Usuario, contraseña y base deben ser los del contenedor PostGIS (README, «Instalación»)
DATABASE_URL=postgis://vigia:CONTRASEÑA@localhost:5432/vigia
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- AIS en vivo: clave GRATUITA en https://aisstream.io (inicia sesión con GitHub → API Keys). ---
# Sin ella: `bash scripts/backend.sh --simulado` (datos SIMULADOS, rotulados).
AISSTREAM_API_KEY=

# --- Opcionales ---
# CABLES_CORREDOR_M=2000                 # ancho del corredor de vigilancia a cada lado del cable
# AIS_HISTORY_INTERVAL_SECONDS=600       # una posición por barco cada N segundos
# AIS_HISTORY_RETENTION_DAYS=60          # días de historial AIS que se conservan

# --- Solo producción (settings/production.py) ---
# CORS_ALLOWED_ORIGINS=https://tu-dominio
# REDIS_PASSWORD=
# DB_SSLMODE=require
# TRUSTED_PROXY_COUNT=1

# --- No van aquí ---
# Corriente y viento: Open-Meteo, sin clave. Cables: TeleGeography, sin clave (manage.py cargar_cables).
# Copernicus Marine (solo scripts/maury_valida.py): se inicia con `copernicusmarine login`, no con este archivo.
